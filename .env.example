# --- News APIs ---
FINNHUB_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- LLM provider selection: claude | gemini | ollama ---
LLM_PROVIDER=claude

# Required only if LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# Required only if LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Required only if LLM_PROVIDER=ollama (model must be pulled locally first)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_EN=

# --- Email (Gmail SMTP) ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
DIGEST_RECIPIENT=
# ^ not read by main.py - recipients come from each person's `email` in
#   config/people.yaml instead. This is only used as the default recipient
#   for src/email_sender.py's own standalone test (python -m src.email_sender).
