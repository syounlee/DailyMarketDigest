# --- News APIs ---
FINNHUB_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- LLM provider selection: claude | gemini | ollama ---
LLM_PROVIDER=claude

# Required only if LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# Required only if LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Required only if LLM_PROVIDER=ollama (models must be pulled locally first)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_KR=
OLLAMA_MODEL_EN=

# --- Email (Gmail SMTP) ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
DIGEST_RECIPIENT=
# ^ optional: who receives the digest, if different from GMAIL_ADDRESS.
#   Defaults to GMAIL_ADDRESS when left blank. Comma-separate for multiple
#   recipients, e.g. DIGEST_RECIPIENT=you@example.com,other@example.com
